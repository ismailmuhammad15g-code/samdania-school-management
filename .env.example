# Copy this file to ".env" and fill in real values.
# IMPORTANT: this is a client-side (vite/React) app, so every VITE_* value
# is inlined into the public JavaScript bundle at build time. These variables
# keep secrets/configuration OUT of the source-code repository and make them
# configurable per deployment — they are NOT hidden from end users who
# inspect the shipped JS. Real secret protection requires a backend.
#
# Admin login for the school management app.
# These values determine the login accepted by the software.
VITE_ADMIN_EMAIL=admin@madrasah.com
VITE_ADMIN_PASSWORD=admin123
VITE_AUTH_SALT=SamdaniaSalt2026

# ── Supabase (online data store) ──
# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=
# Project Settings -> API -> "anon public" key. This key is public.
VITE_SUPABASE_ANON_KEY=

# Public website API origin (gallery, admissions, content, teachers).
# Local development defaults to http://localhost:3018.
# Production builds require the deployed website's HTTPS origin (never localhost).
VITE_MAIN_MADRASAH_API_URL=

# ── SMS (SMS.net.bd) ──
# Server-only settings: NO "VITE_" prefix, so they are never put in the browser bundle.
# The software calls its own /api/sms endpoint (served by `npm run dev` locally and by
# the api/ folder on Vercel). Put these in this .env locally AND in the Vercel project's
# Environment Variables, then restart / redeploy.
SMS_NET_BD_API_KEY=
# Only if the provider has approved a sender ID for your account.
SMS_NET_BD_SENDER_ID=
# Approved campaign content ID. Required only for sending to more than one recipient.
SMS_NET_BD_CONTENT_ID=
#
# Sending SMS needs a Supabase Auth user (same email/password as the software login)
# whose app_metadata contains {"main_madrasah_admin": true}.
